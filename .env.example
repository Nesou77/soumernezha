NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: enables the availability badge text override
# NEXT_PUBLIC_AVAILABLE=true

# Supabase — see SUPABASE_SETUP.md for how to obtain these.
# Project settings -> API. Safe to expose to the browser (anon key is RLS-restricted).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, used exclusively by the seed script
# (npm run seed) to import data/projects.ts into the database.
# NEVER expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
